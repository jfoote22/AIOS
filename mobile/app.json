{
  "expo": {
    "name": "AIOS",
    "slug": "aios-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aios",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aios.mobile"
    },
    "android": {
      "package": "com.aios.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#09090b"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "AIOS needs access to your photos to OCR screenshots and images."
        }
      ],
      "expo-asset",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#09090b"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "AIOS reads your latest screenshot to send it to Second Brain.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "image/*"
          ],
          "disableIOS": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AIOS uses the camera to scan your desktop pairing QR code and to photograph things for Second Brain.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9dde9a53-7266-4d55-89de-64731b9150d9"
      }
    }
  }
}
